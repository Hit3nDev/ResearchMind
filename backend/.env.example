# Copy this file to backend/.env and fill in what you need. Everything is optional:
# without an API key LitLens runs fully on classical NLP (TF-IDF summaries, regex
# information extraction, template-based NLG review, rule-based gap detection).

LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-opus-5-5
DATABASE_URL=sqlite:///./litlens.db
SEMANTIC_SCHOLAR_API_KEY=
